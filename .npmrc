# Supply chain (docs/DEPENDENCIES.md). scripts/check-lockfile.mjs allows exactly these settings (NPMRC) and
# nothing else: no registry, scoped registry or replace-registry-host, which would send installs elsewhere.
# No package runs code when it is installed: the one install step the repo needs (Electron's binary) is run
# explicitly with `npm run install:electron`. scripts/check-lockfile.mjs fails when a new package with an install
# script enters package-lock.json, and scripts/check-installed.mjs checks what `npm ci` installed.
ignore-scripts=true
# npm never runs git, so it cannot clone a git dependency: npm runs a git dependency's `prepare` script even with
# ignore-scripts=true. (A git source fails with ENOGIT before anything runs; package-lock.json has none.)
git=false
# Refuse a package whose "engines" excludes the running Node.
engine-strict=true
# `npm install <pkg>` writes the exact version, never a ^ or ~ range.
save-exact=true
